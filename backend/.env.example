# Copy this file to backend/.env for local backend-only configuration.
# Do not put these variables in frontend/.env or Vite's VITE_* namespace.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ASSESSMENT_ENABLED=false
GEMINI_TIMEOUT_SECONDS=45
ASSESSMENT_RETENTION_SECONDS=3600
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
